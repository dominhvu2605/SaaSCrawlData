# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/saas_crawl_data"

# ─── AUTH ────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── GEMINI API ──────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_MODEL="gemini-1.5-flash"

# ─── EMAIL (SMTP) ────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="SaaS CrawData <your-email@gmail.com>"

# ─── APP ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CrawData"

# ─── WORKER ──────────────────────────────────────────────────
# Secret key for the /api/worker endpoint (prevents unauthorized trigger)
WORKER_SECRET="change-this-worker-secret-key"
# How often worker polls DB (milliseconds) – default 30s
WORKER_INTERVAL_MS="30000"

# ─── RATE LIMITING ───────────────────────────────────────────
# Max requests per IP per minute for crawl API
CRAWL_RATE_LIMIT="10"
